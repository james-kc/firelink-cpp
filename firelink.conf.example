# Firelink flight computer configuration.
# Copy to firelink.conf and edit (or edit live from the pre-flight web page).
# Every value shown here is the compiled-in default; lines can be deleted to
# fall back to them.

# ---- General ---------------------------------------------------------------
callsign=FIRELINK
data_dir=data
web.port=80
arm.require_gps_fix=true

# ---- GPIO (BCM numbering) --------------------------------------------------
gpio.chip=gpiochip0
pin.buzzer=4
pin.geiger=17
pin.lora_m0=22
pin.lora_m1=27
pin.lora_aux=-1

# ---- I2C -------------------------------------------------------------------
i2c.bus=/dev/i2c-1
i2c.addr.gps=0x10
i2c.addr.imu=0x6A
i2c.addr.bme280=0x76

# ---- Sampling rates --------------------------------------------------------
rate.imu_hz=200
rate.bme_hz=10
rate.telemetry_hz=2
rate.landed_telemetry_hz=0.2
gps.update_hz=5
geiger.window_s=60

# ---- GPS freshness ---------------------------------------------------------
# If no NMEA sentence arrives for this long, the fix is reported as lost
# (web UI, telemetry and arming checks) instead of caching the last one.
gps.stale_after_s=10
# Print every raw NMEA line to stdout (diagnostics; noisy).
gps.debug=false

# ---- Barometer calibration -------------------------------------------------
# Pad pressure is sampled that many times (1 s apart); samples further than
# bme.recalibrate_reject_delta_hpa from the median are dropped as corrupt
# (interleaved-bus reads, power dips) so a single spike can't skew the
# zero reference and push relative_altitude to -300 m.
bme.calibrate_samples=12
bme.recalibrate_reject_delta_hpa=0.5

# ---- IMU -------------------------------------------------------------------
imu.accel_range_g=16
imu.gyro_range_dps=2000
imu.odr_hz=833

# ---- LoRa (Waveshare SX1262 868 MHz UART HAT) ------------------------------
lora.uart=/dev/serial0
lora.baud=9600
lora.configure=false
lora.address=0
lora.net_id=0
lora.air_baud=2400
lora.tx_power_dbm=22
lora.channel=18
lora.rssi_append=false
lora.fixed_mode=false

# ---- Landing detection -----------------------------------------------------
# Landing is only considered once a launch has latched: baro altitude gain
# above the pad OR sustained high |accel|, held for launch_confirm_s seconds.
land.launch_alt_m=20
land.launch_accel_ms2=25
land.launch_confirm_s=2
land.min_flight_s=20
land.window_s=15
land.accel_tol=1.5
land.alt_tol_m=3

# ---- Recording -------------------------------------------------------------
# While armed but not launched, CSV rows are buffered in RAM and written out
# decimated to rec.prelaunch_hz. On launch the whole buffer is back-filled at
# full rate, so the launch itself is always captured in full-rate data.
# rec.launch_buffer_s must cover the launch detector's own latency; anything
# below launch_confirm_s + 5 s is raised with a warning at arm time.
# Once landed, recording drops to rec.landed_hz (decimated write-through).
rec.prelaunch_hz=1
rec.launch_buffer_s=15
rec.landed_hz=1

# ---- Geiger ----------------------------------------------------------------
geiger.cpm_per_usvh=153
